# Risk Intelligence Platform - Environment Configuration Template
# Copy this file to .env and update with your values

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://user:pass@localhost:5432/risk_platform

# ============================================================================
# Optional LLM Integration
# ============================================================================
# ENABLE_LLM_EXPLANATION: Control whether LLM is used for explanation generation
# Default: false (platform uses model-based explanations)
# When true: Requires ANTHROPIC_API_KEY to be set
#
# The platform operates FULLY WITHOUT LLM integration.
# Core risk scoring and model-based explainability work by default.
# LLM enhancement is optional for natural language investigation summaries.
ENABLE_LLM_EXPLANATION=false

# ANTHROPIC_API_KEY: Optional, only required when ENABLE_LLM_EXPLANATION=true
# Leave empty to use model-based explanations (default behavior)
# Get your key at: https://console.anthropic.com/
# For the Zhipu GLM gateway, use your BigModel API key here instead.
ANTHROPIC_API_KEY=

# ANTHROPIC_BASE_URL: Optional override for the Anthropic API endpoint.
# Leave empty to use the official Anthropic endpoint.
# To route through an Anthropic-compatible gateway, set the gateway URL, e.g.
#   https://open.bigmodel.cn/api/anthropic   (Zhipu GLM gateway)
ANTHROPIC_BASE_URL=

# ANTHROPIC_MODEL: Model id sent in messages.create().
# Use a Claude model id for the official endpoint, or a provider-specific id
# (e.g. glm-5.2) when ANTHROPIC_BASE_URL points at a compatible gateway.
ANTHROPIC_MODEL=

# LLM Model Configuration (only used when ENABLE_LLM_EXPLANATION=true)
# Replace with your preferred model when enabling LLM enhancement
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# ============================================================================
# Risk Scoring Configuration
# ============================================================================
# Multi-signal fusion weights (must sum to 1.0)
ML_WEIGHT=0.5
RULE_WEIGHT=0.3
GRAPH_WEIGHT=0.2

# Risk level thresholds
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.5

# Detection attribution thresholds
# Methods with scores >= these thresholds are considered to have contributed
DETECTION_ML_THRESHOLD=10.0
DETECTION_RULE_THRESHOLD=15.0
DETECTION_GRAPH_THRESHOLD=10.0

# ============================================================================
# Coordinated Trading Detection
# ============================================================================
COORDINATED_TRADE_TIME_WINDOW_SECONDS=30
COORDINATED_TRADE_PRICE_TOLERANCE=0.01
COORDINATED_TRADE_QUANTITY_TOLERANCE=0.05
COORDINATED_TRADE_MIN_OCCURRENCES=3

# ============================================================================
# Demo Data Generation
# ============================================================================
# Settings for synthetic dataset generation
DEMO_USER_COUNT=2000
DEMO_TRADE_COUNT=20000
DEMO_CLUSTER_COUNT=25
DEMO_NORMAL_RATIO=0.7

# ============================================================================
# Application Settings
# ============================================================================
# Debug mode (development only)
DEBUG=false

# API configuration
API_PREFIX=/api

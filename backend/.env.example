# Application Configuration
APP_NAME=Risk Platform API
APP_VERSION=0.1.0
DEBUG=true

# Database
DATABASE_URL=postgresql://user:pass@database:5432/risk_platform

# CORS
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Model Paths
MODEL_PATH=./ml-models/artifacts

# LLM Configuration
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# Risk Scoring Weights
ML_WEIGHT=0.5
RULE_WEIGHT=0.3
GRAPH_WEIGHT=0.2

# Risk Thresholds
HIGH_RISK_THRESHOLD=0.8
MEDIUM_RISK_THRESHOLD=0.5

# Coordinated Trading Detection
COORDINATED_TRADE_TIME_WINDOW_SECONDS=30
COORDINATED_TRADE_PRICE_TOLERANCE=0.01
COORDINATED_TRADE_QUANTITY_TOLERANCE=0.05
COORDINATED_TRADE_MIN_OCCURRENCES=3

# Demo Data Generation
DEMO_USER_COUNT=2000
DEMO_TRADE_COUNT=20000
DEMO_CLUSTER_COUNT=25
DEMO_NORMAL_RATIO=0.7
